#!/usr/bin/env bash
# shelly - turn a request in plain words into one shell command, then run it.
#
#   shelly list the 3 most recent dirs in here
#
# shelly sends the request to an AI agent in non-interactive mode. It uses
# `claude --dangerously-skip-permissions` first. If `claude` is not in PATH, or
# if `claude` fails, shelly uses `codex --yolo`. The agent replies with one
# protocol line (see `usage`). shelly shows the command as "$ command" and runs it.
# The agent keeps reusable tools in `~/.shelly/bin` and lists them in
# `~/.shelly/TOOLS.md`.

set -u

SHELLY_HOME=${SHELLY_HOME:-$HOME/.shelly}
SELF=$(readlink -f -- "${BASH_SOURCE[0]}")

usage() {
	cat <<'EOF'
usage: shelly [-n] [-y] <request ...>
       shelly --init

shelly asks an AI for one shell command that does <request>.
It shows the command as "$ command" and runs it in the current directory.

options:
  -n          Print the command on stdout. Do not run it.
  -y          Do not ask before a command that the AI marks as destructive.
  --init      Print a bash function. The function runs the commands in your
              own shell, so cd and export stay, and the command goes into the
              history. To use it, add this line to ~/.bashrc:
                eval "$(shelly --init)"
  -h, --help  Show this help.

The AI replies with one line. shelly reads the first word of the line:
  RUN <command>   shelly shows the command and runs it.
  ASK <command>   The command can destroy or publish data. shelly asks first.
  SAY <text>      shelly prints the text on stdout. Nothing runs.
  ERR <text>      shelly prints the text on stderr and exits with status 1.

exit status: the status of the command, 0 after SAY, 1 after ERR or a "no"
answer, 2 when no AI reply is available.

environment:
  SHELLY_HARNESS      "claude" or "codex". shelly uses only that harness.
  SHELLY_CLAUDE_ARGS  More arguments for claude, for example "--model sonnet".
  SHELLY_CODEX_ARGS   More arguments for codex exec.
  SHELLY_HOME         The tool home. The default is ~/.shelly.

Your shell expands * ? $ and quotes before shelly gets the request.
Put the request in quotes when it contains these characters.
EOF
}

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
	C_DIM=$'\033[2m' C_BOLD=$'\033[1m' C_GREEN=$'\033[1;32m'
	C_YELLOW=$'\033[1;33m' C_RED=$'\033[1;31m' C_OFF=$'\033[0m'
else
	C_DIM='' C_BOLD='' C_GREEN='' C_YELLOW='' C_RED='' C_OFF=''
fi

note() { printf 'shelly: %s\n' "$*" >&2; }
fail() { printf '%sshelly: %s%s\n' "$C_RED" "$*" "$C_OFF" >&2; }

# The status line shows while the AI works. Only a terminal gets it.
STATUS_ON=0
status() {
	[ -t 2 ] || return 0
	printf '%sshelly: %s%s' "$C_DIM" "$*" "$C_OFF" >&2
	STATUS_ON=1
}
status_clear() {
	if ((STATUS_ON)); then printf '\r\033[K' >&2; fi
	STATUS_ON=0
}

# The --init function gets the command on fd 3 and runs it with eval.
# fd 1 stays the terminal, so SAY text and -n output show normally.
print_init() {
	local self_q
	printf -v self_q '%q' "$SELF"
	cat <<EOF
# shelly runs the AI command in this shell. cd and export stay, and the command goes into the history.
shelly() {
	local __shelly_cmd
	{ __shelly_cmd=\$($self_q --emit "\$@" 3>&1 1>&4 4>&-); } 4>&1 || return
	[ -n "\$__shelly_cmd" ] || return 0
	history -s -- "\$__shelly_cmd"
	eval "\$__shelly_cmd"
}
EOF
}

init_home() {
	mkdir -p -- "$SHELLY_HOME/bin" "$SHELLY_HOME/tmp" || exit 2
	[ -f "$SHELLY_HOME/TOOLS.md" ] && return 0
	cat >"$SHELLY_HOME/TOOLS.md" <<'EOF' || exit 2
# shelly tools

This file lists the tools in `bin/`. The AI keeps the list current.
shelly gives this file to the AI with each request.
Each tool has one line: `- bin/<name> - <what it does>. Usage: <name> [args]`

EOF
}

system_prompt() {
	local emit=$1 where input
	if ((emit)); then
		where="The command runs with eval in the user's interactive bash shell, in the working directory. Changes from cd, export and alias stay in that shell."
	else
		where="The command runs with 'bash -c' in the working directory, as a child process. Changes from cd and export do not stay after it ends. If the request needs a change that stays (for example, go to a directory), reply ERR and tell the user to add this line to ~/.bashrc: eval \"\$(shelly --init)\""
	fi
	if [ -t 0 ]; then
		input="The standard input of the command is the terminal."
	else
		input="The standard input of the command is piped data, not a terminal. You cannot see that data. The command can read it, for example with sort or grep."
	fi
	cat <<EOF
You are the planner inside shelly, a command-line tool. A user typed a request at a shell prompt. Your job is to turn the request into ONE bash command line. shelly runs that line after you finish. You do not do the request yourself.

Environment:
- Working directory: $PWD
- User: ${USER:-unknown}. Home: $HOME
- System: $(uname -srm)
- $where
- $input
- Tool home: $SHELLY_HOME

Rules:
1. You can run read-only commands (ls, cat, git status, --help, which) to learn facts that the correct command depends on. Most requests need no inspection, so be fast. Do not change files, processes or settings outside the tool home. The command that you reply with is the only thing that acts on the request.
2. The command is a single line. Pipes, &&, ;, and subshells are permitted. Newlines and heredocs are not permitted.
3. When the job is too long for one clear line, or when it is likely to come again, build a tool. Write an executable script to $SHELLY_HOME/bin/<name>, make it print usage for --help, and test it on safe input. Add or update its one-line entry in $SHELLY_HOME/TOOLS.md. Then reply with a command that calls the tool by its full path. Use or fix a tool from the list below before you write a new one.
4. Put scratch files in $SHELLY_HOME/tmp/.
5. Nobody can answer questions from you. If the request has more than one meaning, use the most probable meaning.
6. When the answer comes from the live system, reply with a command that shows it (RUN). Use SAY only when no command is necessary, for example for a general-knowledge question.
7. Reply ASK, not RUN, when the command deletes or overwrites data, kills processes, changes system settings, or publishes data (git push, uploads, messages).
8. The working directory can contain CLAUDE.md or AGENTS.md files with project instructions. Read them when the request is about the project (build, test, run).

Reply format: your final message is exactly one line in one of these forms, with no code fence, no quotes and no other text:
RUN <command>
ASK <command>
SAY <one line of plain text>
ERR <one line of plain text that tells why you cannot make a command>

Contents of $SHELLY_HOME/TOOLS.md:
$(head -n 300 -- "$SHELLY_HOME/TOOLS.md")
EOF
}

# Each ask_<harness> function prints the reply of the agent on stdout.
# The prompt goes in on stdin, so the agent never reads the stdin of shelly.
ask_claude() {
	local -a extra=()
	[ -n "${SHELLY_CLAUDE_ARGS:-}" ] && read -r -a extra <<<"$SHELLY_CLAUDE_ARGS"
	claude -p --dangerously-skip-permissions --safe-mode --no-session-persistence \
		--add-dir "$SHELLY_HOME" --append-system-prompt "$1" "${extra[@]}" <<<"$2"
}

ask_codex() {
	local -a extra=()
	[ -n "${SHELLY_CODEX_ARGS:-}" ] && read -r -a extra <<<"$SHELLY_CODEX_ARGS"
	local out=$RUN_TMP/codex.out
	printf '%s\n\n%s\n' "$1" "$2" |
		codex exec --yolo --skip-git-repo-check --ephemeral --color never \
			-o "$out" "${extra[@]}" - >/dev/null || return
	cat -- "$out"
}

# Print the last line of stdin that starts with a protocol tag, without
# the blanks around it. Print nothing when no line has a tag.
protocol_line() {
	local l last=''
	while IFS= read -r l || [ -n "$l" ]; do
		l=${l%$'\r'}
		l=${l#"${l%%[![:space:]]*}"}
		l=${l%"${l##*[![:space:]]}"}
		case $l in
		'RUN '* | 'ASK '* | 'SAY '* | 'ERR '*) last=$l ;;
		esac
	done
	printf '%s' "$last"
}

# Ask the harnesses in sequence until one replies with a protocol line.
# This sets HARNESS and REPLY_LINE. It exits with status 2 when no reply is available.
ask() {
	local sys=$1 user=$2 h rc reply
	local -a list=()
	case ${SHELLY_HARNESS:-} in
	'')
		for h in claude codex; do
			command -v "$h" >/dev/null && list+=("$h")
		done
		if ((${#list[@]} == 0)); then
			fail "claude and codex are not in PATH"
			exit 2
		fi
		;;
	claude | codex)
		if ! command -v "$SHELLY_HARNESS" >/dev/null; then
			fail "$SHELLY_HARNESS is not in PATH"
			exit 2
		fi
		list=("$SHELLY_HARNESS")
		;;
	*)
		fail "SHELLY_HARNESS must be claude or codex, not '$SHELLY_HARNESS'"
		exit 2
		;;
	esac
	for h in "${list[@]}"; do
		HARNESS=$h
		status "asking $h..."
		reply=$("ask_$h" "$sys" "$user" 2>"$RUN_TMP/err")
		rc=$?
		status_clear
		REPLY_LINE=$(protocol_line <<<"$reply")
		[ -n "$REPLY_LINE" ] && return 0
		if ((rc != 0)); then
			fail "$h failed with exit status $rc"
		else
			fail "$h did not reply with a RUN, ASK, SAY or ERR line"
		fi
		{
			[ -n "$reply" ] && printf '%s\n' "$reply"
			cat -- "$RUN_TMP/err"
		} | tail -n 10 | sed 's/^/  /' >&2
		# A reply without a tag is not a failure of the harness. Do not ask the next harness.
		((rc != 0)) || exit 2
	done
	exit 2
}

log_reply() {
	local req=${1//[$'\t\n']/ }
	printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Is)" "$HARNESS" "$PWD" "$req" "$2" \
		>>"$SHELLY_HOME/history.log"
}

show_cmd() {
	local color=$C_GREEN
	[ "$1" = ASK ] && color=$C_YELLOW
	printf '%s$%s %s%s%s\n' "$color" "$C_OFF" "$C_BOLD" "$2" "$C_OFF" >&2
}

# Ask the user on the terminal. Return 0 only for a "yes" answer.
confirm() {
	local ans=''
	if ! { exec 9<>/dev/tty; } 2>/dev/null; then
		fail "this command can destroy or publish data, and no terminal is available to ask you. Use -y to run it."
		return 1
	fi
	printf '%sshelly: this command can destroy or publish data. Run it? [y/N] %s' "$C_YELLOW" "$C_OFF" >&9
	IFS= read -r ans <&9
	exec 9>&-
	case $ans in
	[yY]*) return 0 ;;
	esac
	note "the command did not run"
	return 1
}

main() {
	local dry=0 yes=0 emit=0
	while (($#)); do
		case $1 in
		-n) dry=1 ;;
		-y) yes=1 ;;
		--emit) emit=1 ;;
		--init)
			print_init
			return 0
			;;
		-h | --help)
			usage
			return 0
			;;
		--)
			shift
			break
			;;
		-*)
			fail "unknown option: $1"
			usage >&2
			return 2
			;;
		*) break ;;
		esac
		shift
	done
	if (($# == 0)); then
		usage >&2
		return 2
	fi
	if ((emit)) && ! { true >&3; } 2>/dev/null; then
		fail "--emit needs fd 3. Use it only through the function from 'shelly --init'."
		return 2
	fi
	local request="$*"

	init_home
	RUN_TMP=$(mktemp -d -- "$SHELLY_HOME/tmp/run.XXXXXX") || exit 2
	trap 'status_clear; rm -rf -- "$RUN_TMP"' EXIT
	trap 'exit 130' INT TERM

	ask "$(system_prompt "$emit")" "Request: $request"

	rm -rf -- "$RUN_TMP"
	trap - EXIT INT TERM

	log_reply "$request" "$REPLY_LINE"
	local tag=${REPLY_LINE%% *} text=${REPLY_LINE#* }
	text=${text#"${text%%[![:space:]]*}"}

	case $tag in
	SAY)
		printf '%s\n' "$text"
		return 0
		;;
	ERR)
		fail "$text"
		return 1
		;;
	esac

	if ((dry)); then
		[ "$tag" = ASK ] && note "the AI marks this command as destructive"
		printf '%s\n' "$text"
		return 0
	fi
	show_cmd "$tag" "$text"
	if [ "$tag" = ASK ] && ((!yes)); then
		confirm || return 1
	fi
	if ((emit)); then
		printf '%s\n' "$text" >&3
		return 0
	fi
	exec bash -c "$text"
}

main "$@"
